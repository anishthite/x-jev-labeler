{
  "manifest_version": 3,
  "name": "Jev Labels for X",
  "version": "1.0.0",
  "description": "Label visible X posts using your Jev prompt.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://openrouter.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html" }
}
